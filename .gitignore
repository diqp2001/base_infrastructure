# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so




# SQLite database files
*.sqlite
*.sqlite3
*.db
*.db3

# MLflow tracking directories
mlruns/
.mlruns/
mlartifacts/

# Local environment / secrets (template: .env.example)
.env
.env.windows
secrets/

# Monitoring state written by the application (logs, job status) and read by the dashboard
.monitor/

# Generated by runs (reports, model weights, results): kept on disk, never committed
results/
weights/
reports/

# test tooling output
.import_linter_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.hypothesis/
