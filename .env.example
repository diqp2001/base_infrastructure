# Development configuration for docker-compose.yml / the VS Code dev container.
# Copy to .env (git-ignored) and fill in the IBKR paper credentials:
#     copy .env.example .env      (Windows)      cp .env.example .env      (WSL / Linux)
# Development values only - never reuse these passwords anywhere else.

# --- SQL Server (service "sqlserver") -------------------------------------------------------
# "sa" password: min. 8 chars with upper case, lower case, digit and symbol.
MSSQL_SA_PASSWORD=Dev_Only_Passw0rd!
# Host port for SSMS / Azure Data Studio on Windows: localhost,14333
MSSQL_HOST_PORT=14333

# --- Application database connection (service "app") ---------------------------------------
# DB_HOST/DB_PORT are fixed in docker-compose.yml to the service: sqlserver:1433
DB_NAME=base_infra
DB_USER=sa
DB_PASSWORD=Dev_Only_Passw0rd!

# --- IB Gateway (service "ibkr") ------------------------------------------------------------
# IBKR username (Client Portal > Settings > Paper Trading Account for the paper username).
# The PASSWORD is not set here: put it in secrets/ibkr_password.txt (git-ignored, chmod 600):
#     mkdir -p secrets && printf '%s' 'your-password' > secrets/ibkr_password.txt && chmod 600 secrets/ibkr_password.txt
TWS_USERID=
IB_GATEWAY_TAG=stable
# paper (default). live also requires IBKR_ALLOW_LIVE=yes and IBKR_PORT=4003.
IBKR_ACCOUNT_MODE=paper
IBKR_ALLOW_LIVE=no
IBKR_READ_ONLY_API=no
# secondary: if the same username is already logged in (TWS on Windows), the container backs off
IBKR_EXISTING_SESSION_ACTION=secondary
# VNC (localhost:5900) to see the Gateway window, e.g. for 2FA; empty = disabled
IBKR_VNC_PASSWORD=
IBKR_HOST_API_PORT=4002
IBKR_HOST_VNC_PORT=5900
TIME_ZONE=America/New_York

# --- Application IBKR connection (service "app") -------------------------------------------
# IBKR_HOST is fixed in docker-compose.yml to the service: ibkr
# IB Gateway container ports: 4004 = paper, 4003 = live
IBKR_PORT=4004
IBKR_CLIENT_ID=1
IBKR_TEST_CLIENT_ID=999
IBKR_CONNECT_RETRIES=6
IBKR_CONNECT_RETRY_DELAY=10
# service_healthy (wait for a logged-in Gateway) | service_started (open the dev container anyway)
IBKR_APP_START_CONDITION=service_healthy

# --- Read-only monitoring dashboard (service "monitor", http://127.0.0.1:8050) ----------------
APP_ENV=development
# SQL Server login used by the dashboard: created by sqlserver-init, member of db_datareader only.
# The password must not contain single quotes.
DB_READONLY_USER=monitor_reader
DB_READONLY_PASSWORD=Dev_Only_Reader_Passw0rd!
# Host address the dashboard is published on. Keep 127.0.0.1 and use `tailscale serve` for phone
# access (docs/MONITORING.md). Never 0.0.0.0 on an untrusted network: the dashboard has no login.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8050
# IBKR client ids of the read-only monitoring connections (must differ from IBKR_CLIENT_ID)
IBKR_MONITOR_CLIENT_ID=90
IBKR_DEV_MONITOR_CLIENT_ID=91
MONITOR_IBKR_ENABLED=true
# Background refresh intervals in seconds
MONITOR_HEALTH_INTERVAL=10
MONITOR_ACCOUNT_INTERVAL=30
MONITOR_POSITIONS_INTERVAL=30
MONITOR_DATA_INTERVAL=30
MONITOR_LOGS_INTERVAL=15

# --- Optional API keys ------------------------------------------------------------------------
FMP_API_KEY=
NASDAQ_API_KEY=
QUANDL_API_KEY=
ERCOT_USERNAME=
ERCOT_PASSWORD=
ERCOT_SUBSCRIPTION_KEY=
