

{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Main File",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Flask App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/interfaces/flask/app.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "FLASK_ENV": "development"
            },
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Monitoring Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": ["--app", "src.interfaces.flask.monitoring_app:app", "run",
                     "--host", "0.0.0.0", "--port", "8051", "--no-reload"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "IBKR_MONITOR_CLIENT_ID": "92"
            },
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}