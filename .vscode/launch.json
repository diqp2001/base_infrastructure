// IBKR / environment settings for the debug runs:
//  * VS Code window on the Windows folder: loaded from .env.windows (git-ignored; template
//    .env.windows.example) -> IBKR_HOST / IBKR_PORT / IBKR_CLIENT_ID / IBKR_ACCOUNT_MODE / ...
//  * Dev Container window: .env.windows does not exist there and is skipped; the container
//    already has its settings from docker-compose.yml (ibkr:4003/4004, sqlserver, ...).
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Main File",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "envFile": "${workspaceFolder}/.env.windows",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Flask App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/interfaces/flask/app.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "FLASK_ENV": "development"
            },
            "envFile": "${workspaceFolder}/.env.windows",
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Monitoring Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": ["--app", "src.interfaces.flask.monitoring_app:app", "run",
                     "--host", "0.0.0.0", "--port", "8051", "--no-reload"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "IBKR_MONITOR_CLIENT_ID": "92"
            },
            "envFile": "${workspaceFolder}/.env.windows",
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}