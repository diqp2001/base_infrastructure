# Connection settings for debug runs on the WINDOWS host (VS Code window opened on the Windows
# folder, Windows .venv). Loaded by .vscode/launch.json ("envFile").
#     copy .env.windows.example .env.windows        (.env.windows is git-ignored)
# Runs inside the Linux dev container do not use this file: their settings come from
# docker-compose.yml and .env (IB Gateway at ibkr:4003/4004, SQL Server at sqlserver:1433).
# Read by src/application/services/misbuffet/brokers/ibkr/ibkr_settings.py.

# --- IBKR: TWS / IB Gateway running on Windows ---------------------------------------------
IBKR_HOST=127.0.0.1
# TWS: 7497 paper / 7496 live by default; IB Gateway: 4002 paper / 4001 live.
# The port is whatever TWS shows in Global Configuration > API > Settings > Socket port.
IBKR_PORT=7497
# Replaces the default client id 1 used by the projects (explicit other ids are kept)
IBKR_CLIENT_ID=1
# paper (default) | live. live also requires IBKR_ALLOW_LIVE=yes, otherwise the broker refuses.
IBKR_ACCOUNT_MODE=paper
IBKR_ALLOW_LIVE=no
# Extra connection attempts while TWS starts / logs in (0 = fail immediately, as before)
IBKR_CONNECT_RETRIES=0
IBKR_CONNECT_RETRY_DELAY=5
# Client id of the read-only monitoring dashboard when it is debugged on Windows
IBKR_MONITOR_CLIENT_ID=92

# --- SQL Server ------------------------------------------------------------------------------
# Leave DB_HOST unset to keep the original Windows connection (localhost, Windows authentication,
# ODBC Driver 17). Set DB_HOST / DB_USER / DB_PASSWORD only to target another server, e.g. the
# SQL Server container from Windows: DB_HOST=127.0.0.1  DB_PORT=14333  DB_USER=sa ...
